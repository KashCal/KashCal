<?xml version="1.0" encoding="utf-8"?>
<!--
  Fake FAB elevation for widgets: Glance has no elevation/shadow modifier, so a soft dark
  rounded-square offset below-behind the accent fill gives the visual "raised" cue. Corner
  radius matches the accent fill in WidgetAddButton so the shadow tracks the FAB shape.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft shadow, nudged down -->
    <item android:top="2dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Slightly tighter, darker core shadow -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#1F000000" />
        </shape>
    </item>
</layer-list>
