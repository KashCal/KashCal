+                importId = uid,
+                calendarId = firstOrphan.calendarId,
+                title = firstOrphan.title,
+                startTs = earliestRecurrenceId,
+                endTs = earliestRecurrenceId,
+                dtstamp = now,
+                status = "CANCELLED",
+                rrule = null,
